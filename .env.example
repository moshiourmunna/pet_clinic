APP_NAME="PetCare Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Dhaka

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL (XAMPP / Laragon). For a quick local test you can use DB_CONNECTION=sqlite instead.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pet_clinic
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Mail: "log" writes emails to storage/logs/laravel.log. Use smtp in production.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@petcareclinic.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS: log (default, writes to laravel.log) | http (real gateway, see config/sms.php)
SMS_DRIVER=log
SMS_API_URL=https://bulksmsbd.net/api/smsapi
SMS_API_KEY=
SMS_SENDER_ID=

# Payments. Leave keys empty + PAYMENT_SIMULATE=true for a demo checkout page.
PAYMENT_SIMULATE=true
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true
